#!/bin/bash
# Atomic VCS: Track tool execution — appends to provenance graph
INPUT=$(cat)
WORKSPACE=$(echo "$INPUT" | jq -r '.workspaceRoots[0] // empty')
if [ -n "$WORKSPACE" ] && [ -d "$WORKSPACE/.atomic" ]; then
  echo "$INPUT" | atomic agent hooks cline post-tool 2>/dev/null
fi
echo '{"cancel":false}'

#!/bin/bash
# Atomic VCS: Track task cancellation — cleans up session
INPUT=$(cat)
WORKSPACE=$(echo "$INPUT" | jq -r '.workspaceRoots[0] // empty')
if [ -n "$WORKSPACE" ] && [ -d "$WORKSPACE/.atomic" ]; then
  echo "$INPUT" | atomic agent hooks cline task-cancel 2>/dev/null
fi
echo '{"cancel":false}'

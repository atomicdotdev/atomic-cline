#!/bin/bash
# Atomic VCS: Track user prompt — saves prompt and model info on session
INPUT=$(cat)
WORKSPACE=$(echo "$INPUT" | jq -r '.workspaceRoots[0] // empty')
if [ -n "$WORKSPACE" ] && [ -d "$WORKSPACE/.atomic" ]; then
  echo "$INPUT" | atomic agent hooks cline user-prompt 2>/dev/null
fi
echo '{"cancel":false}'

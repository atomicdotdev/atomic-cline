#!/bin/bash
# Atomic VCS: Track task resume — reuses existing session view
INPUT=$(cat)
WORKSPACE=$(echo "$INPUT" | jq -r '.workspaceRoots[0] // empty')
if [ -n "$WORKSPACE" ] && [ -d "$WORKSPACE/.atomic" ]; then
  echo "$INPUT" | atomic agent hooks cline task-resume 2>/dev/null
fi
echo '{"cancel":false}'

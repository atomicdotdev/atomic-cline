#!/bin/bash
# Atomic VCS: Record task completion — triggers change recording with provenance
INPUT=$(cat)
WORKSPACE=$(echo "$INPUT" | jq -r '.workspaceRoots[0] // empty')
if [ -n "$WORKSPACE" ] && [ -d "$WORKSPACE/.atomic" ]; then
  echo "$INPUT" | atomic agent hooks cline task-complete 2>/dev/null
fi
echo '{"cancel":false}'
